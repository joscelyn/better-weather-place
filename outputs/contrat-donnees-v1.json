  "auxiliary_point_values": [
    {
      "id": "elevation",
      "label_fr": "Altitude",
      "unit": "m",
      "click_decimals": 0,
      "source": "Copernicus DEM GLO-30",
      "storage": { "dtype": "int16", "scale_factor": 1, "nodata": -32768 }
    },
    {
      "id": "land_fraction",
      "label_fr": "Proportion de terre dans la maille climatique",
      "unit": "%",

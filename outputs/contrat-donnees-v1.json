{
  "schema_version": "0.1-draft",
  "reference_period": {
    "start_year": 1991,
    "end_year": 2020,
    "label": "Normale climatique 1991–2020"
  },
  "calendar": "gregorian",
  "months": [
    { "number": 1, "id": "01", "label_fr": "janvier" },
    { "number": 2, "id": "02", "label_fr": "février" },
    { "number": 3, "id": "03", "label_fr": "mars" },
    { "number": 4, "id": "04", "label_fr": "avril" },
    { "number": 5, "id": "05", "label_fr": "mai" },
    { "number": 6, "id": "06", "label_fr": "juin" },
    { "number": 7, "id": "07", "label_fr": "juillet" },
    { "number": 8, "id": "08", "label_fr": "août" },
    { "number": 9, "id": "09", "label_fr": "septembre" },
    { "number": 10, "id": "10", "label_fr": "octobre" },
    { "number": 11, "id": "11", "label_fr": "novembre" },
    { "number": 12, "id": "12", "label_fr": "décembre" }
  ],
  "domain": {
    "geometry_file": "emprise-cerra-officielle.geojson",
    "water_mask_source": "Copernicus DEM GLO-30 WBM",
    "canaries_enabled_in_v1": false
  },
  "asset_contract": {
    "display_template": "data/1991-2020/{layer_id}/{month}.pmtiles",
    "value_template": "data/1991-2020/{layer_id}/{month}.tif",
    "display_format": "PMTiles v3 raster WebP",
    "value_format": "Cloud Optimized GeoTIFF",
    "display_projection": "EPSG:3857",
    "value_projection": "EPSG:4326",
    "value_tiling": "256 x 256 pixels",
    "value_compression": "DEFLATE",
    "value_overviews": [2, 4, 8, 16, 32],
    "display_webp_quality_for_pilot": 85,
    "relief_mode": "separate-raster-layer",
    "relief_template": "data/terrain/relief.pmtiles",
    "relief_profile": {
      "source": "Copernicus DEM GLO-30 and WBM",
      "low_zoom_range": [3, 7],
      "low_zoom_processing_resolution": "approximately 1 km",
      "high_zoom_range": [8, 10],
      "high_zoom_processing_resolution": "approximately 90 m",
      "native_max_zoom": 10,
      "water_is_transparent": true,
      "note": "Relief resolution does not change the native resolution of climate layers."
    },
    "http_requirements": ["HTTPS", "Range requests", "CORS when cross-origin"]
  },
  "rounding": {
    "mode": "half-away-from-zero",
    "note": "Round only for display; calculations retain the stored precision."
  },
  "warnings": {
    "coastal_mixed_cell": {
      "condition": "land_fraction_in_climate_cell < 0.80",
      "label_fr": "Cellule côtière mixte",
      "message_fr": "La valeur climatique représente une cellule contenant à la fois de la terre et de l’eau."
    },
    "complex_terrain": {
      "condition": "abs(click_elevation_m - climate_cell_median_elevation_m) >= 250 or climate_cell_elevation_p90_minus_p10_m >= 300",
      "label_fr": "Relief complexe",
      "message_fr": "La valeur de la maille peut différer sensiblement entre vallée, versant et sommet."
    },
    "sarah_edge": {
      "condition": "latitude >= 63 and latitude <= 65 and layer_id == 'sunshine'",
      "label_fr": "Bord de couverture satellite",
      "message_fr": "La durée d’ensoleillement est proche de la limite nord de SARAH-3 et doit être interprétée avec prudence."
    },
    "northern_sunshine_indicative": {
      "condition": "latitude > 65 and layer_id == 'sunshine'",
      "label_fr": "Estimation indicative",
      "message_fr": "Au nord de 65° N, l’ensoleillement provient de CERRA et présente une incertitude plus élevée."
    },
    "water_click": {
      "condition": "WBM class != 0",
      "label_fr": "Point situé sur l’eau",
      "message_fr": "Aucune valeur terrestre n’est affichée. Une cellule terrestre voisine peut être proposée à moins de 2 km."
    }
  },
